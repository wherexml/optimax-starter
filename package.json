{
  "name": "optimax-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "@trpc/server": "^11.19.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@trpc/client": "^11.19.0",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.5",
      "@types/pg": "^8.23.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @optimax-starter/db db:push",
    "db:studio": "bun run --filter @optimax-starter/db db:studio",
    "db:generate": "bun run --filter @optimax-starter/db db:generate",
    "db:migrate": "bun run --filter @optimax-starter/db db:migrate",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@optimax-starter/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
