{
  "name": "optimax-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.5",
      "@types/pg": "^8.23.1",
      "hono": "^4.13.7",
      "recharts": "^3.11.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @optimax-starter/db db:push",
    "db:studio": "bun run --filter @optimax-starter/db db:studio",
    "db:generate": "bun run --filter @optimax-starter/db db:generate",
    "db:migrate": "bun run --filter @optimax-starter/db db:migrate",
    "db:check": "node scripts/check-migrations.mjs",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "bootstrap": "./scripts/bootstrap-project.sh",
    "gen:module": "node scripts/gen-module.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup-server.mjs",
    "verify": "python3 scripts/verify-console.py"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@optimax-starter/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vitest": "^3.1.0"
  },
  "packageManager": "bun@1.3.14"
}
