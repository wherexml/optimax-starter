# syntax=docker/dockerfile:1
FROM oven/bun:1.3.14 AS bun

# Stage 1: Cached workspace dependency installation
FROM node:24.10.0-bookworm-slim AS deps
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app

COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY apps/web/package.json apps/web/bunfig.toml apps/web/.env.schema apps/web/
COPY apps/server/package.json apps/server/bunfig.toml apps/server/.env.schema apps/server/
COPY packages/api/package.json packages/api/
COPY packages/config/package.json packages/config/tsconfig.base.json packages/config/
COPY packages/db/package.json packages/db/.env.schema packages/db/
COPY packages/ui/package.json packages/ui/
# @starter:agent-start
COPY packages/agent/package.json packages/agent/
# @starter:agent-end
RUN bun install --frozen-lockfile

# Stage 2: Type generation and production bundle compilation
FROM deps AS builder
ARG VITE_APP_SLUG=optimax-starter
ARG VITE_APP_TITLE=OptiMax
ARG VITE_ENABLE_DEMOS=false
ARG VITE_SERVER_URL=http://127.0.0.1:38140
ENV NODE_ENV=production \
    VITE_APP_SLUG=${VITE_APP_SLUG} \
    VITE_APP_TITLE=${VITE_APP_TITLE} \
    VITE_ENABLE_DEMOS=${VITE_ENABLE_DEMOS} \
    VITE_SERVER_URL=${VITE_SERVER_URL} \
    CORS_ORIGIN=http://127.0.0.1:38140 \
    DATABASE_URL=postgres://build:build@127.0.0.1:5432/build

COPY . .
RUN bun run env:generate && bun run build

# Stage 3: Minimal non-root Node 24 production runtime
FROM node:24.10.0-bookworm-slim AS runner
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app

ENV NODE_ENV=production \
    PORT=38140 \
    STARTER_SEED_DEMO=false \
    SERVE_WEB_DIST=/app/apps/web/dist

COPY --from=builder --chown=node:node /app/package.json /app/bun.lock /app/bunfig.toml /app/tsconfig.json ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/apps/web/dist ./apps/web/dist
COPY --from=builder --chown=node:node /app/apps/server/package.json /app/apps/server/.env.schema ./apps/server/
COPY --from=builder --chown=node:node /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=builder --chown=node:node /app/apps/server/dist ./apps/server/dist
# @starter:agent-start
# Assistant skills are read at runtime (cwd apps/server -> src/agent/skills).
COPY --from=builder --chown=node:node /app/apps/server/src/agent/skills ./apps/server/src/agent/skills
# @starter:agent-end
COPY --from=builder --chown=node:node /app/packages/config ./packages/config
COPY --from=builder --chown=node:node /app/packages/db ./packages/db
# Third-party notices for ported code (Magpie MIT) ship inside the image.
COPY --from=builder --chown=node:node /app/third_party ./third_party

USER node
EXPOSE 38140
CMD ["sh", "-ec", "cd apps/server && exec node dist/node.mjs"]
