# Server-side only. Empty configuration disables AI; values are read when a gateway is created.
STARTER_AI_BASE_URL=
STARTER_AI_MODEL=
STARTER_AI_API_KEY=
# A private regular file takes precedence over the inline key. Max 4096 bytes; no world write.
STARTER_AI_API_KEY_FILE=
STARTER_AI_CA_FILE=
STARTER_AI_PROTOCOL=openai-completions
STARTER_AI_STRUCTURED_MODE=
# Starter names; the aliases STARTER_AI_MAX_CONCURRENCY / STARTER_AI_PER_ACTOR_CONCURRENCY /
# STARTER_AI_QUEUE_TIMEOUT_MS are also accepted.
STARTER_AI_CONCURRENCY=4
STARTER_AI_ACTOR_LIMIT=2
STARTER_AI_QUEUE_LIMIT=16
STARTER_AI_QUEUE_WAIT_MS=15000
STARTER_AI_TIMEOUT_MS=60000
# Exact host allowlist for intentionally private HTTP gateways (alias: STARTER_AI_HTTP_HOSTS).
# HTTPS needs no allowlist. In production plain HTTP is only accepted for listed hosts.
STARTER_AI_ALLOW_HTTP_HOSTS=
# Optional chat UI display label; defaults to STARTER_AI_MODEL. Not returned by status endpoints.
STARTER_AI_MODEL_LABEL=
# Optional: 64-hex AES-256-GCM key file that enables model maintenance from the web console.
STARTER_AI_CONFIG_KEY_FILE=
