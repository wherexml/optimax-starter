{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "current": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "qOp": {
          "type": "string",
          "enum": [
            "contains",
            "equals"
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "已登记",
                "待复核"
              ]
            },
            {
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "已登记",
                  "待复核"
                ]
              }
            }
          ]
        },
        "domain": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "instruction",
    "current"
  ],
  "additionalProperties": false
}
