{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "admin",
        "super_admin"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "email": {
      "type": "string",
      "maxLength": 254
    },
    "company": {
      "type": "string",
      "maxLength": 120
    }
  },
  "additionalProperties": false
}
