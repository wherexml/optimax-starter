APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:38142

LOG_CHANNEL=stack

# D2 零迁移：缓存走文件 store（无 cache 表依赖，LB-07）
CACHE_STORE=file
LOG_LEVEL=debug

# 与根 .env / Docker compose 共享的键（LARAVEL.md「配置对齐」）。
# TS 侧（web/server/db）由 varlock .env.schema 管理；本文件是 PHP 侧唯一模板。
# SESSION_COOKIE_NAME 与 8h 生命周期沿用现有栈（core/config.ts）；config 接线在 LB-05。
DB_CONNECTION=pgsql
DATABASE_URL=postgres://starter:${STARTER_DB_PASSWORD}@db:5432/starter
SESSION_COOKIE_NAME=optimax_console
SESSION_LIFETIME=480
STARTER_ADMIN_USERNAME=demo@optimax.hk
STARTER_ADMIN_PASSWORD=
STARTER_SEED_DEMO=true
CORS_ORIGIN=http://127.0.0.1:38140

# 附件盘（LD-02）：local 开发态；s3 兼容 OSS 需配 ATTACHMENT_S3_KEY/SECRET/BUCKET/ENDPOINT/REGION。
ATTACHMENT_DISK=local

# asset-agent 桥上游（LC-07/D5）：默认指向本地 compose 的 node api 服务；
# 生产由 compose.ai.prod.yaml 注入 http://ai:38141，未配置时 agent 端点返回 503。
STARTER_NODE_API_URL=http://api:38141

# 可选：Boost 拉取第三方 skills 的 GitHub token（匿名限流 60/h，配置后 5000/h）；仅开发态，值不入库
# BOOST_GITHUB_TOKEN=
