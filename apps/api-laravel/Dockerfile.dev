# 本地开发镜像（LB-02）：php-cli + artisan serve；生产形态（D6/LD-03）另立 Dockerfile.prod。
# vendor 由 compose 挂载宿主机目录提供，镜像内不做 composer install。
FROM php:8.4-cli
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev curl \
    && docker-php-ext-install pdo_pgsql pgsql \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /var/www/html
EXPOSE 8080

# 直接用 PHP 内建服务器 + 框架路由脚本：继承容器完整环境变量。
# （artisan serve 会按静态白名单过滤传给 php -S worker 的 env，导致 compose 注入的
#  DATABASE_URL 等共享键在 HTTP 上下文不可见——LB-02 实测发现。）
CMD ["sh", "-ec", "cd public && exec php -S 0.0.0.0:8080 ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"]
