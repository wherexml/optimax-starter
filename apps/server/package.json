{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/trpc-server": "^0.4.2",
    "@node-rs/argon2": "^2.2.2",
    "@optimax-starter/api": "workspace:*",
    "@optimax-starter/db": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.7",
    "tsx": "^4.23.15",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@optimax-starter/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
