# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=number
PORT=38141

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @public @type=string(minLength=1)
SESSION_COOKIE_NAME=optimax_console

# @public @type=boolean
STARTER_SEED_DEMO=true

# @optional @public @type=string
STARTER_ADMIN_USERNAME=

# @optional @type=string
STARTER_ADMIN_PASSWORD=

# @optional @public @type=string
SERVE_WEB_DIST=

# @optional @type=string
STARTER_MAGPIE_RELAY_URL=

# @optional @public @type=string
STARTER_MAGPIE_MODEL=

# Server-side OpenAI-compatible model client (asset agent). Empty = disabled.
# Only a key FILE path is configured; the key value never goes into env.
# @optional @public @type=string
STARTER_AI_BASE_URL=

# @optional @public @type=string
STARTER_AI_MODEL=

# @optional @public @type=string
STARTER_AI_API_KEY_FILE=

# @optional @public @type=string
STARTER_AI_CA_FILE=

# Comma-separated hosts allowed over plain HTTP; ignored (refused) when NODE_ENV=production.
# @optional @public @type=string
STARTER_AI_ALLOW_HTTP_HOSTS=

# max_tokens | max_completion_tokens; empty = by host (api.openai.com uses max_completion_tokens).
# @optional @public @type=string
STARTER_AI_TOKEN_FIELD=

# @optional @public @type=string
STARTER_AI_TIMEOUT_MS=

# @optional @public @type=string
STARTER_AI_CONCURRENCY=

# @optional @public @type=string
STARTER_AI_QUEUE_LIMIT=

# @optional @public @type=string
STARTER_AI_QUEUE_WAIT_MS=

# @optional @public @type=string
STARTER_AI_ACTOR_LIMIT=

# [starter:agent-start]
# Directory overriding the bundled assistant skills (<dir>/assistant/SKILL.md).
# @optional @public @type=string
STARTER_AGENT_SKILLS_DIR=
# [starter:agent-end]

# Trust the first hop of X-Forwarded-For / X-Real-IP for client IP (login rate limit, audit, sessions).
# Only enable behind a reverse proxy that overwrites these headers; otherwise the socket address is used.
# @optional @public @type=boolean
TRUST_PROXY=false

# Legacy SSO entry passthrough for GET /console/auth/providers (disabled by default).
# @optional @public @type=boolean
AUTH_SSO_ENABLED=false

# @optional @public @type=string
AUTH_SSO_LABEL=

# @optional @public @type=string
AUTH_SSO_LOGIN_PATH=

# Standard OIDC enterprise SSO (Authorization Code + PKCE). Disabled unless ENABLED=true and
# ISSUER / CLIENT_ID / LABEL are set. Never auto-creates accounts; only links existing active ones.
# @optional @public @type=boolean
AUTH_OIDC_ENABLED=false

# Slug [a-z0-9_-]{1,32}; used in /console/auth/sso/<id>/start|callback.
# @optional @public @type=string
AUTH_OIDC_PROVIDER_ID=oidc

# @optional @public @type=string
AUTH_OIDC_LABEL=

# @optional @public @type=string
AUTH_OIDC_ISSUER=

# @optional @public @type=string
AUTH_OIDC_CLIENT_ID=

# Prefer AUTH_OIDC_CLIENT_SECRET_FILE (private file path); the env value is the fallback.
# @optional @type=string
AUTH_OIDC_CLIENT_SECRET=

# @optional @public @type=string
AUTH_OIDC_CLIENT_SECRET_FILE=

# @optional @public @type=string
AUTH_OIDC_SCOPES=openid profile email

# Default: ${CORS_ORIGIN}/console/auth/sso/<provider>/callback
# @optional @public @type=string
AUTH_OIDC_REDIRECT_URI=

# Link an unlinked (provider, sub) to an existing active account by verified email or preferred_username.
# @optional @public @type=boolean
AUTH_OIDC_ALLOW_EMAIL_LINK=true

# Set to false to switch the login page to SSO-only mode (enforced only when an SSO provider is active).
# @optional @public @type=boolean
AUTH_PASSWORD_LOGIN_ENABLED=true

# Feishu enterprise OAuth 2.0 + PKCE (disabled by default; enable on demand via .agents/skills/feishu-auth).
# @optional @public @type=boolean
AUTH_FEISHU_ENABLED=false

# @optional @public @type=string
AUTH_FEISHU_APP_ID=

# Prefer AUTH_FEISHU_APP_SECRET_FILE (private file path); the env value is the fallback.
# @optional @type=string
AUTH_FEISHU_APP_SECRET=

# @optional @public @type=string
AUTH_FEISHU_APP_SECRET_FILE=

# Required Feishu enterprise tenant_key; rejects identities from other tenants.
# @optional @public @type=string
AUTH_FEISHU_TENANT_KEY=

# @optional @public @type=string
AUTH_FEISHU_LABEL=使用飞书登录

# Default: ${CORS_ORIGIN}/console/auth/sso/feishu/callback
# @optional @public @type=string
AUTH_FEISHU_REDIRECT_URI=

# Link an unlinked open_id to an existing active account by matching enterprise email.
# @optional @public @type=boolean
AUTH_FEISHU_ALLOW_EMAIL_LINK=true

# Create a `member` account on first verified Feishu login inside the configured tenant.
# @optional @public @type=boolean
AUTH_FEISHU_AUTO_PROVISION=false

# Optional endpoint overrides for local HTTP mock testing (HTTPS enforced when NODE_ENV=production).
# @optional @public @type=string
AUTH_FEISHU_AUTHORIZE_URL=

# @optional @public @type=string
AUTH_FEISHU_API_BASE=

# Attachment storage. Default: local directory (mount a persistent volume in containers).
# @optional @public @type=string
STARTER_UPLOAD_DIR=./data/uploads

# Max upload size in bytes (default 10485760 = 10 MiB, capped at 100 MiB).
# @optional @public @type=string
STARTER_UPLOAD_MAX_BYTES=10485760

# local | s3. s3 is used only when every STARTER_S3_* value below is set; otherwise falls back to local.
# @optional @public @type=string
STARTER_STORAGE_DRIVER=local

# S3-compatible endpoint (path-style), e.g. https://s3.ap-east-1.amazonaws.com or http://minio:9000
# @optional @public @type=string
STARTER_S3_ENDPOINT=

# @optional @public @type=string
STARTER_S3_BUCKET=

# @optional @public @type=string
STARTER_S3_REGION=

# @optional @type=string
STARTER_S3_ACCESS_KEY_ID=

# Prefer STARTER_S3_SECRET_ACCESS_KEY_FILE (private file path); the env value is the fallback.
# @optional @type=string
STARTER_S3_SECRET_ACCESS_KEY=

# @optional @public @type=string
STARTER_S3_SECRET_ACCESS_KEY_FILE=

# Background job worker (PostgreSQL SKIP LOCKED queue). Set to false to disable in this process.
# @optional @public @type=string
STARTER_JOBS_ENABLED=true
