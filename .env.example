# =============================================================================
# OptiMax Starter 环境变量模板（安全示例，勿填入真实生产密钥后提交仓库）
# 本地快速初始化：./scripts/init-local.sh
# 新项目一键改名派生：./scripts/bootstrap-project.sh <project-slug> --title "项目名称"
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 项目身份与前端展示（构建/开发均读取）
# -----------------------------------------------------------------------------
VITE_APP_SLUG=optimax-starter
VITE_APP_TITLE=OptiMax
# 是否启用 /demo/* 规范演示路由与侧栏 Demo 分组（本地开发 true，正式交付设为 false）
VITE_ENABLE_DEMOS=true

# -----------------------------------------------------------------------------
# 2. 端口与同源代理（五位相邻端口，仅绑定 127.0.0.1）
# -----------------------------------------------------------------------------
WEB_PORT=38140
API_PORT=38141
CORS_ORIGIN=http://127.0.0.1:38140
VITE_SERVER_URL=http://127.0.0.1:38141
# Vite /console 转发目标：Compose 容器内默认 http://api:38141；宿主机直跑设为 http://127.0.0.1:38141
API_PROXY_TARGET=http://api:38141

# -----------------------------------------------------------------------------
# 3. 会话、数据库与本地演示种子
# -----------------------------------------------------------------------------
# 同一机器运行多个项目时必须使用不同 Cookie 名，避免 127.0.0.1 登录态互相覆盖
SESSION_COOKIE_NAME=optimax_console

# 由 init-local.sh 或 bootstrap-project.sh 随机生成
STARTER_DB_PASSWORD=

# 是否在启动时幂等创建本地演示管理员与 12 条示例资产（生产环境必须为 false）
STARTER_SEED_DEMO=true
# 本地：演示管理员账号与密码。生产：仅当 console_account 为空时一次性创建首个 super_admin
# （密码禁止 demo@2026!，至少 10 位）；首次登录后立即改密，并从 .env.production 删除 STARTER_ADMIN_PASSWORD
STARTER_ADMIN_USERNAME=demo@optimax.hk
STARTER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 4. 可选扩展能力（未配置时自动静默关闭，不阻塞启动）
# -----------------------------------------------------------------------------
# 服务端模型客户端（默认关闭，凭证值只放私有文件，不写入 env）
STARTER_AI_BASE_URL=
STARTER_AI_MODEL=
STARTER_AI_API_KEY_FILE=
STARTER_AI_CA_FILE=
STARTER_AI_ALLOW_HTTP_HOSTS=
STARTER_AI_TOKEN_FIELD=
STARTER_AI_TIMEOUT_MS=
STARTER_AI_CONCURRENCY=
STARTER_AI_QUEUE_LIMIT=
STARTER_AI_QUEUE_WAIT_MS=
STARTER_AI_ACTOR_LIMIT=
# compose.ai.yaml / compose.ai.prod.yaml 读取的宿主机私有文件路径（不是密钥值）
STARTER_AI_SECRET_FILE=

# 原本地 Magpie 转发的可选兼容；新客户端配置优先
STARTER_MAGPIE_RELAY_URL=
STARTER_MAGPIE_MODEL=

# 反向代理后取真实客户端 IP（登录限流、审计、会话 IP）。仅在代理会覆盖 X-Forwarded-For 时开启
TRUST_PROXY=false

# 企业 SSO 旧扩展位（自定义登录入口直通，默认关闭）
AUTH_SSO_ENABLED=false
AUTH_SSO_LABEL=
AUTH_SSO_LOGIN_PATH=

# 标准 OIDC 企业单点登录（授权码 + PKCE，默认关闭；只关联已有启用账户，绝不自动建号）
AUTH_OIDC_ENABLED=false
AUTH_OIDC_PROVIDER_ID=oidc
AUTH_OIDC_LABEL=企业单点登录
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
# 优先使用私有文件路径；密钥值不要写入仓库
AUTH_OIDC_CLIENT_SECRET_FILE=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPES=openid profile email
# 默认 ${CORS_ORIGIN}/console/auth/sso/<provider>/callback，需在 IdP 注册
AUTH_OIDC_REDIRECT_URI=
# 未关联时按已验证邮箱或 preferred_username 匹配已有启用账户
AUTH_OIDC_ALLOW_EMAIL_LINK=true

# 设为 false 可隐藏账号密码表单，仅保留企业单点登录（仅在至少一个 SSO 生效时生效，防锁死）
AUTH_PASSWORD_LOGIN_ENABLED=true

# 飞书企业自建应用 OAuth 2.0 + PKCE 登录（默认关闭；按需通过 .agents/skills/feishu-auth 开启）
AUTH_FEISHU_ENABLED=false
AUTH_FEISHU_APP_ID=
# 优先使用私有文件路径；密钥值不要写入仓库
AUTH_FEISHU_APP_SECRET_FILE=
AUTH_FEISHU_APP_SECRET=
# 必填，强校验飞书企业租户 tenant_key
AUTH_FEISHU_TENANT_KEY=
AUTH_FEISHU_LABEL=使用飞书登录
# 默认 ${CORS_ORIGIN}/console/auth/sso/feishu/callback，需在飞书开发者后台登记
AUTH_FEISHU_REDIRECT_URI=
# 未关联时是否按企业邮箱匹配已有启用账户
AUTH_FEISHU_ALLOW_EMAIL_LINK=true
# 设为 true 时，首次飞书登录将在校验同企业租户后自动创建 member 普通成员账户
AUTH_FEISHU_AUTO_PROVISION=false

# -----------------------------------------------------------------------------
# 5. 附件存储与后台任务
# -----------------------------------------------------------------------------
# 本地存储目录（Compose 中为持久卷 uploads:/app/data/uploads）
STARTER_UPLOAD_DIR=./data/uploads
# 单文件上限（字节），默认 10 MiB
STARTER_UPLOAD_MAX_BYTES=10485760
# local | s3；s3 仅在下列 STARTER_S3_* 全部配置时生效，否则回落本地存储
STARTER_STORAGE_DRIVER=local
STARTER_S3_ENDPOINT=
STARTER_S3_BUCKET=
STARTER_S3_REGION=
STARTER_S3_ACCESS_KEY_ID=
# 优先使用私有文件路径；密钥值不要写入仓库
STARTER_S3_SECRET_ACCESS_KEY_FILE=
STARTER_S3_SECRET_ACCESS_KEY=
# 后台任务 worker（PostgreSQL SKIP LOCKED 队列），设为 false 可在本进程关闭
STARTER_JOBS_ENABLED=true
