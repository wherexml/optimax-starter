# =============================================================================
# OptiMax Starter 环境变量模板（安全示例，勿填入真实生产密钥后提交仓库）
# 本地快速初始化：./scripts/init-local.sh
# 新项目一键改名派生：./scripts/bootstrap-project.sh <project-slug> --title "项目名称"
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 项目身份与前端展示（构建/开发均读取）
# -----------------------------------------------------------------------------
VITE_APP_SLUG=optimax-starter
VITE_APP_TITLE=OptiMax
# 是否启用 /demo/* 规范演示路由与侧栏 Demo 分组（本地开发 true，正式交付设为 false）
VITE_ENABLE_DEMOS=true

# -----------------------------------------------------------------------------
# 2. 端口与同源代理（五位相邻端口，仅绑定 127.0.0.1）
# -----------------------------------------------------------------------------
WEB_PORT=38140
API_PORT=38141
CORS_ORIGIN=http://127.0.0.1:38140
VITE_SERVER_URL=http://127.0.0.1:38141
# Vite /console 转发目标：Compose 容器内默认 http://api:38141；宿主机直跑设为 http://127.0.0.1:38141
API_PROXY_TARGET=http://api:38141

# -----------------------------------------------------------------------------
# 3. 会话、数据库与本地演示种子
# -----------------------------------------------------------------------------
# 同一机器运行多个项目时必须使用不同 Cookie 名，避免 127.0.0.1 登录态互相覆盖
SESSION_COOKIE_NAME=optimax_console

# 由 init-local.sh 或 bootstrap-project.sh 随机生成
STARTER_DB_PASSWORD=

# 是否在启动时幂等创建本地演示管理员与 12 条示例资产（生产环境必须为 false）
STARTER_SEED_DEMO=true
STARTER_ADMIN_USERNAME=demo@optimax.hk
STARTER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 4. 可选扩展能力（未配置时自动静默关闭，不阻塞启动）
# -----------------------------------------------------------------------------
# 服务端模型客户端（默认关闭，凭证值只放私有文件，不写入 env）
STARTER_AI_BASE_URL=
STARTER_AI_MODEL=
STARTER_AI_API_KEY_FILE=
STARTER_AI_CA_FILE=
STARTER_AI_ALLOW_HTTP_HOSTS=
STARTER_AI_TOKEN_FIELD=
STARTER_AI_TIMEOUT_MS=
STARTER_AI_CONCURRENCY=
STARTER_AI_QUEUE_LIMIT=
STARTER_AI_QUEUE_WAIT_MS=
STARTER_AI_ACTOR_LIMIT=
# compose.ai.yaml / compose.ai.prod.yaml 读取的宿主机私有文件路径（不是密钥值）
STARTER_AI_SECRET_FILE=

# 原本地 Magpie 转发的可选兼容；新客户端配置优先
STARTER_MAGPIE_RELAY_URL=
STARTER_MAGPIE_MODEL=

# 企业 SSO 预留扩展位（默认关闭）
AUTH_SSO_ENABLED=false
AUTH_SSO_LABEL=
AUTH_SSO_LOGIN_PATH=
# Laravel 迁移栈（LARAVEL.md 阶段 B；APP_KEY 在 apps/api-laravel/.env 本地生成，不入库）
API_LARAVEL_PORT=38142

# 附件存储（LD-02）：local 开发态默认；S3 兼容 OSS 生产态（MinIO 验证见 scripts/e2e/attachments-parity.py）
ATTACHMENT_S3_KEY=starterminio
ATTACHMENT_S3_SECRET=starterminio-secret
ATTACHMENT_S3_BUCKET=starter-attachments
ATTACHMENT_S3_ENDPOINT=http://host.docker.internal:38470
